{
  "name": "tauqeet-js",
  "version": "1.0.3",
  "description": "Next generation of Tauqeet.js - Modular, Private, High-Precision, and Headless.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./prayer": {
      "types": "./dist/prayer/index.d.ts",
      "import": "./dist/prayer/index.js",
      "require": "./dist/prayer/index.cjs"
    },
    "./qibla": {
      "types": "./dist/qibla/index.d.ts",
      "import": "./dist/qibla/index.js",
      "require": "./dist/qibla/index.cjs"
    },
    "./moon": {
      "types": "./dist/moon-visibility/index.d.ts",
      "import": "./dist/moon-visibility/index.js",
      "require": "./dist/moon-visibility/index.cjs"
    },
    "./astronomy": {
      "types": "./dist/astronomy/index.d.ts",
      "import": "./dist/astronomy/index.js",
      "require": "./dist/astronomy/index.cjs"
    },
    "./factory": {
      "types": "./dist/factory/index.d.ts",
      "import": "./dist/factory/index.js",
      "require": "./dist/factory/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "prayer-times",
    "astronomy",
    "meeus",
    "precision",
    "solar",
    "lunar",
    "qibla",
    "islamic"
  ],
  "author": "Ghulam Hasnain",
  "license": "MIT",
  "sideEffects": false,
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
