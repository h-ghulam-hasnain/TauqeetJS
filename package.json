{
  "name": "tauqeet-js",
  "version": "1.1.5",
  "description": "High-precision TypeScript library for Islamic astronomical calculations: prayer times, Qibla direction, moon phase & crescent visibility, and Hijri calendar conversions.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./prayers": {
      "types": "./dist/prayers/index.d.ts",
      "import": "./dist/prayers/index.js",
      "require": {
        "types": "./dist/prayers/index.d.cts",
        "default": "./dist/prayers/index.cjs"
      }
    },
    "./qibla": {
      "types": "./dist/qibla/index.d.ts",
      "import": "./dist/qibla/index.js",
      "require": {
        "types": "./dist/qibla/index.d.cts",
        "default": "./dist/qibla/index.cjs"
      }
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "require": {
        "default": "./dist/*/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "docs": "typedoc",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "islam",
    "prayer",
    "prayer-times",
    "qibla",
    "moon",
    "crescent",
    "astronomical",
    "ephemeris",
    "typescript"
  ],
  "author": {
    "name": "Ghulam Hasnain",
    "url": "https://github.com/h-ghulam-hasnain"
  },
  "license": "MIT",
  "homepage": "https://tauqeet-js.web.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h-ghulam-hasnain/TauqeetJS.git"
  },
  "bugs": {
    "url": "https://github.com/h-ghulam-hasnain/TauqeetJS/issues"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}